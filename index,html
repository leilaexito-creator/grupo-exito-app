                saldoAtual += prev.credito - prev.debito;

                tbody.innerHTML += `
                    <tr>
                        <td>${prev.data || '-'}</td>
                        <td>${prev.clienteNome}</td>
                        <td>${prev.descricao || 'Recebimento mensal'}</td>
                        <td>${prev.debito ? prev.debito.toFixed(2).replace('.', ',') : '-'}</td>
                        <td>${prev.credito ? prev.credito.toFixed(2).replace('.', ',') : '-'}</td>
