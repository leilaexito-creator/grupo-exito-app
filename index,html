        // Fazer cadastro de novo parceiro
        function fazerCadastro() {
            const nome = document.getElementById('cadastroNome').value.trim();
            const email = document.getElementById('cadastroEmail').value.trim();
            const user = document.getElementById('cadastroUser').value.trim();
            const pass = document.getElementById('cadastroPassword').value;
            const errorDiv = document.getElementById('cadastroError');
            const sucessoDiv = document.getElementById('cadastroSucesso');

            errorDiv.classList.add('hidden');
            sucessoDiv.style.display = 'none';

            // Validações
            if (!nome || !email || !user || !pass) {
                errorDiv.textContent = 'Todos os campos são obrigatórios!';
                errorDiv.classList.remove('hidden');
                return;
            }

            if (user.length < 3) {
                errorDiv.textContent = 'Usuário deve ter pelo menos 3 caracteres!';
                errorDiv.classList.remove('hidden');
                return;
            }

            if (pass.length < 4) {
                errorDiv.textContent = 'Senha deve ter pelo menos 4 caracteres!';
                errorDiv.classList.remove('hidden');
                return;
            }

            // Verificar se usuário já existe
            if (usuariosRegistrados[user]) {
                errorDiv.textContent = 'Este usuário já existe! Escolha outro.';
                errorDiv.classList.remove('hidden');
                return;
            }

            // Registrar novo parceiro
            const novoParceiroId = Math.max(...Object.values(usuariosRegistrados)
                .filter(u => u.tipo === 'parceiro')
                .map(u => u.parceiroId || 0), 0) + 1;

            usuariosRegistrados[user] = {
                senha: pass,
                tipo: 'parceiro',
                parceiroId: novoParceiroId,
                nome: nome,
                email: email
            };

            // Salvar no localStorage
            localStorage.setItem('usuariosRegistrados', JSON.stringify(usuariosRegistrados));

            // Mostrar mensagem de sucesso
            sucessoDiv.textContent = `✅ Cadastro realizado com sucesso! Bem-vindo, ${nome}! Agora faça login.`;
            sucessoDiv.style.display = 'block';

            // Limpar formulário
            document.getElementById('cadastroNome').value = '';
            document.getElementById('cadastroEmail').value = '';
            document.getElementById('cadastroUser').value = '';
            document.getElementById('cadastroPassword').value = '';

            // Voltar para aba de login após 2 segundos
            setTimeout(() => {
                trocarAbaLogin('entrar');
            }, 2000);
        }

