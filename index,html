        // REGRA 1: Puxar 50% para Planilha do Parceiro em CRÉDITO
        function puxar50ParaPlanilhaParceiro(movimento) {
            if (!movimento.parceiroId || movimento.credito <= 0) return;
            
            const parceiro = parceiros.find(p => p.id == movimento.parceiroId);
            if (!parceiro) return;
            
            // Verificar se já existe lançamento para este movimento
            const lancamentoExistente = planilhaParceiros.find(l => l.movimentoId === movimento.id && l.tipo === '50%');
            
            if (!lancamentoExistente) {
                const valor50 = movimento.credito * 0.5;
                const novoLancamento = {
                    id: Date.now(),
                    parceiroId: movimento.parceiroId,
                    movimentoId: movimento.id,
                    tipo: '50%',
                    data: movimento.data,
                    descricao: `50% - ${movimento.descricao}`,
                    debito: 0,
                    credito: valor50
                };
                planilhaParceiros.push(novoLancamento);
                console.log('REGRA 1: 50% puxado para Planilha do Parceiro - Crédito:', valor50);
                salvarDados();
                carregarPlanilhaParceiro();
            }
        }

