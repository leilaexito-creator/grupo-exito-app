            tbody.innerHTML = '';
            
            const previsoesMes = previsoes.filter(p => p.mes === mes).sort((a, b) => new Date(a.data || 0) - new Date(b.data || 0));
            
            let saldoAnterior = 0;
            const mesAnterior = new Date(mes + '-01');
            mesAnterior.setMonth(mesAnterior.getMonth() - 1);
            const mesAnteriorStr = mesAnterior.toISOString().slice(0, 7);
            const previsoesMesAnterior = previsoes.filter(p => p.mes === mesAnteriorStr);
            if (previsoesMesAnterior.length > 0) {
                let saldoFinal = 0;
                previsoesMesAnterior.forEach(p => {
                    saldoFinal += p.credito - p.debito;
                });
                saldoAnterior = saldoFinal;
            }
            
            // Adicionar linha de saldo anterior
            tbody.innerHTML += `
                <tr style="background-color: #f0f0f0; font-weight: bold;">
