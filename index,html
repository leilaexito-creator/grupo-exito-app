        // ===== FUNÇÕES DE CONTAS PENDENTES =====
        function atualizarTabelaContasPendentes() {
            const tbody = document.getElementById('contasLeilaTable');
            if (!tbody) return;

            tbody.innerHTML = '';
            const hoje = new Date();
            const mesAtual = new Date().toISOString().slice(0, 7);

            // Pegar os pagamentos do mês atual
            const pagamentosMes = previsaoPagamentos[mesAtual] || [];

            let encontrouPendentes = false;

            pagamentosMes.forEach(pagamento => {
                if (!pagamento.vencimento) return;

                const dataVencimento = new Date(pagamento.vencimento);
                dataVencimento.setHours(0, 0, 0, 0);

                // Ainda não venceu
                if (dataVencimento >= hoje) return;

                // Verifica se já foi paga
                const paga = pagamento.pago || false;

                if (paga) return;

                encontrouPendentes = true;

                const diasAtraso = Math.floor(
                    (hoje - dataVencimento) / (1000 * 60 * 60 * 24)
                );

                tbody.innerHTML += `
                    <tr style="background:#ffeeba;">
                        <td>${pagamento.nome}</td>
                        <td>R$ ${pagamento.valor.toFixed(2).replace('.', ',')}</td>
                        <td>${formatarData(dataVencimento)}</td>
                        <td style="color:#d9534f;">
                            🚨 ${diasAtraso} dias em atraso
                        </td>
                        <td><span style="color:#ff6b6b;">🚨 ${diasAtraso} dias em atraso</span></td>
                        <td>
                            <button class="btn btn-success btn-small"
                                onclick="pagarContaLeila('${pagamento.nome}', ${pagamento.valor})">
                                Pagar
                            </button>
                        </td>
                    </tr>
                `;
            });

            if (!encontrouPendentes) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px; color: #999;">✅ Nenhuma conta pendente</td></tr>';
            }
        }

        function pagarContaLeila(nome, valor) {
            const hoje = new Date();
            const mesAtual = new Date().toISOString().slice(0, 7);

            // Marcar como pago em previsaoPagamentos
            const pagamentosMes = previsaoPagamentos[mesAtual] || [];
            pagamentosMes.forEach(pag => {
                if (pag.nome === nome && !pag.pago) {
                    pag.pago = true;
                    pag.dataPagamento = new Date().toISOString().slice(0, 10);
                }
            });

            // Adicionar no fluxo de caixa
            fluxoCaixa.push({
                id: Date.now(),
                data: formatarData(hoje),
                mes: mesAtual,
                descricao: `Pagamento ${nome}`,
                debito: valor,
                credito: 0,
                despesasEscritorio: 0,
                retiradasLeila: 0,
                parceiroId: '',
                marcadoPagamento: true
            });

            salvarDados();
            atualizarTabelaContasPendentes();
            atualizarTabelaPrevisaoPagamentos();
            atualizarFluxo();

            alert(`✅ Pagamento de ${nome} marcado como pago!`);
        }

        function pagarContaLeila(descricao, valor) {
            const hoje = new Date();
            const mesAtual = new Date().toISOString().slice(0, 7);

            fluxoCaixa.push({
                id: Date.now(),
