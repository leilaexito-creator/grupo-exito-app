            // REMOVIDO: Lógica automática de 50% - agora é acionada apenas quando você seleciona o parceiro no Fluxo de Caixa

            // Adicionar despesas de funcionários do parceiro (50% rateado)
            const funcionariosParceiro = funcionariosParceiros.filter(f => f.parceiroId == parceiroId && f.mes === mes);
            let totalFuncionarios = 0;
            funcionariosParceiro.forEach(func => {
                totalFuncionarios += func.debito;
