        function extrairTextoPDF(arquivo) {
            const fileReader = new FileReader();
            fileReader.onload = function() {
                const typedarray = new Uint8Array(this.result);
                pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                    let textoCompleto = '';
                    let promessas = [];
                    
                    for (let i = 1; i <= pdf.numPages; i++) {
                        promessas.push(
                            pdf.getPage(i).then(function(page) {
                                return page.getTextContent().then(function(textContent) {
                                    return textContent.items.map(function(item) { return item.str; }).join(' ');
                                });
                            })
                        );
                    }
                    
                    Promise.all(promessas).then(function(paginas) {
                        textoCompleto = paginas.join('\n');
                        processarTextoPDF(textoCompleto);
                    }).catch(function(err) {
                        alert('Erro ao processar PDF: ' + err.message);
                    });
                }).catch(function(err) {
                    alert('Erro ao ler o PDF: ' + err.message);
                });
            };
            fileReader.readAsArrayBuffer(arquivo);
        }
        
        function usarOCR(arquivo) {
            alert('PDF detectado como imagem. Usando OCR para extrair dados...');
            const fileReader = new FileReader();
            fileReader.onload = function() {
                const typedarray = new Uint8Array(this.result);
                pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                    let textoOCR = '';
                    let paginasProcessadas = 0;
                    for (let i = 1; i <= pdf.numPages; i++) {
                        pdf.getPage(i).then(function(page) {
                            const canvas = document.createElement('canvas');
                            const context = canvas.getContext('2d');
                            const viewport = page.getViewport({scale: 2});
                            canvas.width = viewport.width;
                            canvas.height = viewport.height;
                            page.render({canvasContext: context, viewport: viewport}).promise.then(function() {
                                Tesseract.recognize(canvas, 'por').then(function(result) {
                                    textoOCR += result.data.text + '\n';
                                    paginasProcessadas++;
                                    if (paginasProcessadas === pdf.numPages) {
                                        processarTextoPDF(textoOCR);
                                    }
                                }).catch(function(err) {
                                    alert('Erro ao processar OCR: ' + err.message);
                                });
                            });
                        });
                    }
                }).catch(function(err) {
                    alert('Erro ao ler o PDF para OCR: ' + err.message);
                });
            };
            fileReader.readAsArrayBuffer(arquivo);
        }
        
        function processarTextoPDF(texto) {
            const mes = new Date().toISOString().slice(0, 7);
            const linhas = texto.split('\n');
            let movimentosAdicionados = 0;
            
            for (let i = 0; i < linhas.length; i++) {
                let linha = linhas[i].trim();
                
                if (linha.length < 15) continue;
                if (!/^\d{2}\/\d{2}\/\d{4}/.test(linha)) continue;
                if (/SALDO DIA|SALDO ANTERIOR/.test(linha)) continue;
                
                const matchData = linha.match(/(\d{2}\/\d{2}\/\d{4})/);
                if (!matchData) continue;
                
                let tipo = '';
                if (/PIX RECEBIDO|DEVOLUCAO PIX|DEPOSITO/.test(linha)) {
                    tipo = 'CREDITO';
                } else if (/PIX ENVIADO|COMPRA|SAQUE|TRANSFERENCIA|ESTORNO COMPRA/.test(linha)) {
                    tipo = 'DEBITO';
                } else {
                    continue;
                }
                
                const matchValor = linha.match(/(\d+[.,]\d{2})\s*([DC])(?:\s|$)/);
                if (!matchValor) continue;
                
                const valor = parseFloat(String(matchValor[1]).replace(',', '.'));
                const indicador = matchValor[2];
                
                const ehDebito = indicador === 'D' || tipo === 'DEBITO';
                const ehCredito = indicador === 'C' || tipo === 'CREDITO';
                
                if (valor > 0) {
                    let descricao = linha.substring(0, 100).trim();
                    if (/PIX ENVIADO/.test(linha)) descricao = 'PIX Enviado';
                    else if (/PIX RECEBIDO/.test(linha)) descricao = 'PIX Recebido';
                    else if (/COMPRA CARTAO/.test(linha)) descricao = 'Compra no Cartao';
                    else if (/ESTORNO|DEVOLUCAO/.test(linha)) descricao = 'Estorno/Devolucao';
                    else if (/TRANSFERENCIA/.test(linha)) descricao = 'Transferencia';
                    else if (/DEPOSITO/.test(linha)) descricao = 'Deposito';
                    else if (/SAQUE/.test(linha)) descricao = 'Saque';
                    
                    fluxoCaixa.push({
                        id: Date.now() + movimentosAdicionados,
                        mes,
                        saldoAnterior: 0,
                        descricao: descricao,
                        debito: ehDebito ? valor : 0,
                        credito: ehCredito ? valor : 0,
                        despesasEscritorio: 0,
                        retiradasLeila: 0
                    });
                    movimentosAdicionados++;
                }
            }
            
            if (movimentosAdicionados > 0) {
                salvarDados();
                atualizarFluxo();
                atualizarDashboard();
                alert(movimentosAdicionados + ' movimentos importados do PDF com sucesso!');
            } else {
                const textoExtraido = texto.substring(0, 200);
                const temTexto = textoExtraido.trim().length > 50;
                
                if (!temTexto) {
                    alert('Erro: O PDF nao contem texto extraivel.\n\nPossiveis causas:\n1. PDF eh uma imagem scaneada\n2. PDF esta protegido\n3. Arquivo corrompido\n\nSolucao:\n- Use um PDF com texto extraivel\n- Ou use CSV para importar\n- Ou preencha manualmente');
                } else {
                    alert('Nenhum movimento foi encontrado.\n\nFormato esperado:\nDD/MM/YYYY - HH:MM:SS | Tipo | Valor D/C\n\nExemplo:\n11/12/2025 - 08:45:17 | PIX ENVIADO | 200,00 D');
                }
            }
        }

