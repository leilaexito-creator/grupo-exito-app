    <script>
        // Dados em memória
        let clientes = [];
        let parceiros = [];
        let fluxoCaixa = [];
        let planilhaParceiros = [];
        let previsoes = [];
        let previsaoPagamentos = {};
        let previsaoRecebimentos = {};
        let previsoesDespesas = {};
        let contasLeila = [];
        let despesasLeila = [];
        let funcionariosParceiros = [];
        let chatMessages = [];

        const tabs = ['dashboard', 'clientes', 'parceiros', 'fluxo', 'planilha', 'contas-leila', 'previsao-pagamentos', 'extratos', 'reclamatorias', 'despesas-leila', 'funcionarios', 'inadimplentes', 'contas-pendentes', 'ia'];
        let currentTabIndex = 0;

        // Função para formatar datas em DD/MM/AAAA
        function formatarData(data) {
            if (!data) return '-';
            if (typeof data === 'string') {
                if (data.match(/^\d{2}\/\d{2}\/\d{4}$/)) return data;
                if (data.match(/^\d{4}-\d{2}-\d{2}$/)) {
                    const [ano, mes, dia] = data.split('-');
                    return `${dia}/${mes}/${ano}`;
                }
            }
            if (data instanceof Date) {
                const dia = String(data.getDate()).padStart(2, '0');
                const mes = String(data.getMonth() + 1).padStart(2, '0');
                const ano = data.getFullYear();
                return `${dia}/${mes}/${ano}`;
            }
            return '-';
        }

        // Carregar dados do localStorage
        function carregarDados() {
            const dados = localStorage.getItem('grupoExitoDados');
            if (dados) {
                const parsed = JSON.parse(dados);
                clientes = parsed.clientes || [];
                parceiros = parsed.parceiros || [];
                fluxoCaixa = parsed.fluxoCaixa || [];
                planilhaParceiros = parsed.planilhaParceiros || [];
                previsoes = parsed.previsoes || [];
                previsaoPagamentos = parsed.previsaoPagamentos || {};
                contasLeila = parsed.contasLeila || [];
                despesasLeila = parsed.despesasLeila || [];
                funcionariosParceiros = parsed.funcionariosParceiros || [];
            }
            atualizarSelects();
            atualizarDashboard();
        }

        // Salvar dados no localStorage
        function salvarDados() {
            localStorage.setItem('grupoExitoDados', JSON.stringify({
                clientes, parceiros, fluxoCaixa, planilhaParceiros, previsoes, previsaoPagamentos, contasLeila, despesasLeila, funcionariosParceiros
            }));
        }

        // Trocar abas
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            const buttons = document.querySelectorAll('.tab-button');
            buttons[tabs.indexOf(tabName)].classList.add('active');
            
            currentTabIndex = tabs.indexOf(tabName);
            
            // Atualizar tabelas quando abrir abas específicas
            if (tabName === 'previsao-pagamentos') {
                sincronizarPagamentoPrevisao();
                atualizarTabelaPrevisaoPagamentos();
            }
            
            if (tabName === 'inadimplentes') {
                carregarDados();
                atualizarTabelaPrevisaoRecebimentos();
                atualizarTabelaClientesInadimplentes();
            }
            
            if (tabName === 'contas-leila') {
                carregarDados();
                atualizarTabelaContasPendentes();
            }
            
            atualizarBotoes();
        }

        // Navegar entre abas com botões
        function avancarAba() {
            if (currentTabIndex < tabs.length - 1) {
                currentTabIndex++;
                switchTabByIndex(currentTabIndex);
            }
        }

        function voltarAba() {
            if (currentTabIndex > 0) {
                currentTabIndex--;
                switchTabByIndex(currentTabIndex);
            }
        }

        function switchTabByIndex(index) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabs[index]).classList.add('active');
            document.querySelectorAll('.tab-button')[index].classList.add('active');
            atualizarBotoes();
        }

        function atualizarBotoes() {
            document.getElementById('btnVoltar').disabled = currentTabIndex === 0;
            document.getElementById('btnAvancar').disabled = currentTabIndex === tabs.length - 1;
            document.getElementById('pageIndicator').textContent = `Página ${currentTabIndex + 1} de ${tabs.length}`;
        }

        // Adicionar Cliente
        function adicionarCliente() {
            const razaoSocial = document.getElementById('razaoSocial').value;
            const nomeFantasia = document.getElementById('nomeFantasia').value;
            const cnpj = document.getElementById('cnpj').value;
            const email = document.getElementById('emailCliente').value;
            const valorContrato = parseFloat(document.getElementById('valorContrato').value.replace(',', '.'));
            const parceiro = document.getElementById('parceiroPrincipal').value;
            const dataFechamento = document.getElementById('dataFechamentoContrato').value;
            const diaVencimento = parseInt(document.getElementById('diaVencimentoHonorarios').value);
            const retiradadaParceiros = document.getElementById('retiradadaParceiros').value;

            if (!razaoSocial || !valorContrato) {
                alert('Preencha os campos obrigatórios!');
                return;
            }

            const novoCliente = {
                id: Date.now(),
                razaoSocial,
                nomeFantasia,
                cnpj,
                email,
                valorContrato,
                parceiro,
                dataFechamento,
                diaVencimento,
                retiradadaParceiros,
                lancamento_100_feito: 'NAO',
                lancamento_50_feito: 'NAO',                dataCadastro: formatarData(new Date()),
            };
            
            adicionarLog('Cliente criado: ID=' + novoCliente.id + ', Nome=' + razaoSocial + ', Retirada100%=' + retiradadaParceiros);
            
            clientes.push(novoCliente);
            
            // REGRA 1: Gatilho pos-criacao - Executar apos cliente ser salvo
            executarRegra1(novoCliente);

            salvarDados();
            limparFormularioClientes();
            atualizarTabelaClientes();
            atualizarDashboard();
            atualizarSelects();
        }

        function atualizarTabelaClientes() {
            const tbody = document.getElementById('clientesTable');
            tbody.innerHTML = '';
            clientes.forEach(cliente => {
                tbody.innerHTML += `
                    <tr>
                        <td>${cliente.razaoSocial}</td>
                        <td>${cliente.nomeFantasia || '-'}</td>
                        <td>${cliente.cnpj || '-'}</td>
                        <td>${cliente.email || '-'}</td>
                        <td>R$ ${cliente.valorContrato.toFixed(2).replace('.', ',')}</td>
                        <td>${cliente.parceiro ? parceiros.find(p => p.id == cliente.parceiro)?.nome || '-' : '-'}</td>
                        <td>${cliente.dataVencimento || '-'}</td>
                        <td><button class="btn btn-danger btn-small" onclick="deletarCliente(${cliente.id})">Deletar</button></td>
                    </tr>
                `;
            });
        }

        function deletarCliente(id) {
            clientes = clientes.filter(c => c.id !== id);
            salvarDados();
            atualizarTabelaClientes();
            atualizarDashboard();
        }
        

        // LOG DE DEPURACAO
        const logAutomacao = [];
        function adicionarLog(mensagem) {
            const timestamp = new Date().toLocaleTimeString();
            const logEntry = '[' + timestamp + '] ' + mensagem;
            logAutomacao.push(logEntry);
            console.log(logEntry);
        }
        
        // REGRA 1: Debito 100% quando cliente criado com Retirada 100% = SIM
        function executarRegra1(cliente) {
            adicionarLog('Verificando REGRA 1 para cliente: ' + cliente.razaoSocial);
            
            const condicao1 = cliente.retiradadaParceiros === 'sim';
            const condicao2 = cliente.parceiro && cliente.parceiro !== '';
            const condicao3 = cliente.valorContrato > 0;
            const condicao4 = cliente.lancamento_100_feito !== 'SIM';
            
            adicionarLog('REGRA 1 - Condicoes: Retirada100%=SIM(' + condicao1 + '), Parceiro(' + condicao2 + '), Valor>0(' + condicao3 + '), Nao lancado(' + condicao4 + ')');
            
            if (condicao1 && condicao2 && condicao3 && condicao4) {
                const lancamento = {
                    id: Date.now(),
                    parceiroId: cliente.parceiro,
                    clienteId: cliente.id,
                    descricao: 'Cliente ' + cliente.razaoSocial + ' - 100% parceiro',
                    debito: cliente.valorContrato,
                    credito: 0,
                    data: formatarData(new Date()),
                    tipo: '100%'
                };
                
                planilhaParceiros.push(lancamento);
                adicionarLog('REGRA 1 EXECUTOU: Lancamento criado na Planilha - Debito=R$' + lancamento.debito.toFixed(2).replace('.', ','));
                
                cliente.lancamento_100_feito = 'SIM';
                adicionarLog('REGRA 1: Cliente marcado como lancamento_100_feito=SIM');
            } else {
                adicionarLog('REGRA 1 PULOU: Condicoes nao atendidas');
            }
        }

        function limparFormularioClientes() {
            document.getElementById('razaoSocial').value = '';
            document.getElementById('nomeFantasia').value = '';
            document.getElementById('cnpj').value = '';
            document.getElementById('emailCliente').value = '';
            document.getElementById('valorContrato').value = '';
