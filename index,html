        // Fluxo de Caixa
        function adicionarLinhaFluxo() {
            const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
            fluxoCaixa.push({
                id: Date.now(),
                mes,
                saldoAnterior: 0,
                descricao: '',
                debito: 0,
                credito: 0,
                despesasEscritorio: 0,
                retiradasLeila: 0
            });
            salvarDados();
            atualizarFluxo();
        }

        function atualizarFluxo() {
            const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
            document.getElementById('mesCompetenciaFluxo').textContent = new Date(mes + '-01').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
            
            const fluxoMes = fluxoCaixa.filter(f => f.mes === mes).sort((a, b) => new Date(a.data || 0) - new Date(b.data || 0));
            
            const tbody = document.getElementById('fluxoTable');
            tbody.innerHTML = '';
            
            // Buscar saldo anterior do mês anterior
            let saldoAnterior = 0;
            const mesAnterior = new Date(mes + '-01');
            mesAnterior.setMonth(mesAnterior.getMonth() - 1);
            const mesAnteriorStr = mesAnterior.toISOString().slice(0, 7);
            const fluxoMesAnterior = fluxoCaixa.filter(f => f.mes === mesAnteriorStr);
            if (fluxoMesAnterior.length > 0) {
                let saldoFinalAnterior = 0;
                fluxoMesAnterior.forEach(f => {
                    saldoFinalAnterior += f.credito - f.debito - f.despesasEscritorio - f.retiradasLeila;
                });
                saldoAnterior = saldoFinalAnterior;
            }
            
            // Adicionar linha de saldo anterior
            tbody.innerHTML += `
                <tr style="background-color: #f0f0f0; font-weight: bold;">
                    <td colspan="8"><strong>SALDO ANTERIOR:</strong></td>
                    <td>R$ ${saldoAnterior.toFixed(2).replace('.', ',')}</td>
                    <td></td>
                </tr>
            `;
            
            let totalReceitas = 0;
            let totalReceitaEscritorio = 0;
            let totalDebito = 0;
            let totalDespesasEscritorio = 0;
            let totalRetiradasLeila = 0;
            let totalDespesas = 0;

            fluxoMes.forEach((movimento, index) => {
                const saldo = saldoAnterior + movimento.credito - movimento.debito - movimento.despesasEscritorio - movimento.retiradasLeila;
                totalReceitas += movimento.credito;
                totalReceitaEscritorio += movimento.receitaEscritorio || 0;
                totalDebito += movimento.debito;
                totalDespesasEscritorio += movimento.despesasEscritorio;
                totalRetiradasLeila += movimento.retiradasLeila;
                totalDespesas += movimento.debito + movimento.despesasEscritorio + movimento.retiradasLeila;

                const valor50 = movimento.credito * 0.5;
                tbody.innerHTML += `
                    <tr>
                        <td>R$ ${saldoAnterior.toFixed(2).replace('.', ',')}</td>
                        <td><input type="text" value="${movimento.descricao}" onchange="atualizarMovimento(${movimento.id}, 'descricao', this.value)"></td>
                        <td><input type="number" value="${movimento.debito.toFixed(2)}" step="0.01" onchange="atualizarMovimento(${movimento.id}, 'debito', this.value)"></td>
                        <td><input type="number" value="${movimento.credito.toFixed(2)}" step="0.01" onchange="atualizarMovimento(${movimento.id}, 'credito', this.value)"></td>
                        <td><input type="number" value="${(movimento.receitaEscritorio || 0).toFixed(2)}" step="0.01" onchange="atualizarMovimento(${movimento.id}, 'receitaEscritorio', this.value)"></td>
                        <td><input type="number" value="${movimento.despesasEscritorio.toFixed(2)}" step="0.01" onchange="atualizarMovimento(${movimento.id}, 'despesasEscritorio', this.value)"></td>
                        <td><input type="number" value="${movimento.retiradasLeila.toFixed(2)}" step="0.01" onchange="atualizarMovimento(${movimento.id}, 'retiradasLeila', this.value)"></td>
                        <td><select onchange="atualizarMovimento(${movimento.id}, 'parceiroId', this.value)" style="width: 100%;"><option value="">-- Selecione --</option>${parceiros.map(p => `<option value="${p.id}" ${movimento.parceiroId == p.id ? 'selected' : ''}>${p.nome}</option>`).join('')}</select></td>
                        <td><strong>R$ ${valor50.toFixed(2).replace('.', ',')}</strong></td>
                        <td>R$ ${saldo.toFixed(2).replace('.', ',')}</td>
                        <td><button class="btn btn-danger btn-small" onclick="deletarFluxo(${movimento.id})">Deletar</button></td>
                    </tr>
                `;
                saldoAnterior = saldo;
            });

            document.getElementById('totalReceitas').textContent = `R$ ${totalReceitas.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalReceitaEscritorio').textContent = `R$ ${totalReceitaEscritorio.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalDebito').textContent = `R$ ${totalDebito.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalDespesasEscritorio').textContent = `R$ ${totalDespesasEscritorio.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalRetiradasLeila').textContent = `R$ ${totalRetiradasLeila.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalDespesas').textContent = `R$ ${totalDespesas.toFixed(2).replace('.', ',')}`;
            document.getElementById('saldoFinal').textContent = `R$ ${(totalReceitas - totalDespesas).toFixed(2).replace('.', ',')}`;
            
            calcularRateio();
            atualizarRelatorioReclamatorias();
            atualizarTabelaDespesasEscritorio();
            sincronizarContasPendentes();
            sincronizarClientesInadimplentes();
            atualizarTabelaPrevisaoRecebimentos();
        }

        function atualizarMovimento(id, campo, valor) {
            const movimento = fluxoCaixa.find(f => f.id === id);
            if (movimento) {
                if (campo === 'descricao') {
                    movimento.descricao = valor;
                } else if (campo === 'parceiroId') {
                    movimento.parceiroId = valor;
                    // REGRA 1: Quando seleciona parceiro, puxa 50% para Planilha do Parceiro
                    const creditoNumerico = parseFloat(movimento.credito) || 0;
                    if (valor && creditoNumerico > 0) {
                        puxar50ParaPlanilhaParceiro(movimento);
                    }
                
                } else {
                    // Converter vírgula para ponto para aceitar formato brasileiro
                    const valorFormatado = String(valor).replace(',', '.');
                    movimento[campo] = parseFloat(valorFormatado) || 0;
                }
                
                // Se foi alterado Despesas Dra. Leila (pagamento), sincronizar com previsão de pagamentos
                if ((campo === 'retiradasLeila' || campo === 'despesasEscritorio') && movimento.descricao && movimento[campo] > 0) {
                    sincronizarComPrevisaoPagamentos(movimento);
                }
                
                // Se foi alterado Crédito (recebimento), sincronizar com previsão de recebimentos
                if (campo === 'credito' && movimento.descricao && movimento.credito > 0) {
                    sincronizarComPrevisaoRecebimentos(movimento);
                }
                
                salvarDados();
                atualizarFluxo();
                atualizarDashboard();
            }
        }
        
        // REGRA 2: Lancamento automatico para Recebimento 100% = NAO (50% do fluxo de caixa)
        // REGRA 2 REMOVIDA: Você digita manualmente os 50% na Planilha do Parceiro
        
        function sincronizarComPrevisaoPagamentos(movimento) {
            // Procurar por um pagamento na previsão que corresponda à descrição
            const mes = movimento.mes || new Date().toISOString().slice(0, 7);
            const pagamentos = previsaoPagamentos[mes] || [];
            
            // Determinar o valor do movimento (pode ser retiradasLeila ou despesasEscritorio)
            const valorMovimento = movimento.retiradasLeila > 0 ? movimento.retiradasLeila : movimento.despesasEscritorio;
            
            // Procurar por um pagamento que corresponda à descrição
            for (let i = pagamentos.length - 1; i >= 0; i--) {
                const pag = pagamentos[i];
                // Verificar se a descrição do movimento contém o nome do pagamento
                if (movimento.descricao.toLowerCase().includes(pag.nome.toLowerCase())) {
                    // Verificar se o valor é aproximadamente igual (com margem de 0.01)
                    if (Math.abs(valorMovimento - pag.valor) < 0.01) {
                        // Remover da previsão
                        pagamentos.splice(i, 1);
                        salvarDados();
                        atualizarTabelaPrevisaoPagamentos();
                        break; // Sair após encontrar e remover
                    }
                }
            }
        }

        function sincronizarComPrevisaoRecebimentos(movimento) {
            // Procurar por um recebimento na previsao que corresponda ao cliente
            const mes = movimento.mes || new Date().toISOString().slice(0, 7);
            const [anoSelecionado, mesSelecionado] = mes.split('-').map(Number);
            
            // Procurar por um cliente que corresponda a descricao do movimento
            clientes.forEach(cliente => {
                if (cliente.diaVencimento && movimento.descricao.toLowerCase().includes(cliente.razaoSocial.toLowerCase())) {
                    // Verificar se o valor eh aproximadamente igual ao valor do contrato
                    if (Math.abs(movimento.credito - cliente.valorContrato) < 0.01) {
                        // Cliente foi recebido, atualizar a tabela de previsao
                        atualizarTabelaPrevisaoRecebimentos();
                    }
                }
            });
        }

        function deletarFluxo(id) {
            fluxoCaixa = fluxoCaixa.filter(f => f.id !== id);
            salvarDados();
            atualizarFluxo();
            atualizarDashboard();
        }

        function calcularRateio() {
            const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
            const fluxoMes = fluxoCaixa.filter(f => f.mes === mes);
            
            let totalReceitaEscritorio = 0;
            let totalDespesasEscritorio = 0;
            
            fluxoMes.forEach(f => {
                totalReceitaEscritorio += f.receitaEscritorio || 0;
                totalDespesasEscritorio += f.despesasEscritorio || 0;
            });

            const numParceiros = parseInt(document.getElementById('numParceiros').value) || 1;
            const totalRatear = totalReceitaEscritorio - totalDespesasEscritorio;
            const valorPorParceiro = totalRatear / numParceiros;

            document.getElementById('totalDespesasRateio').textContent = `R$ ${totalDespesasEscritorio.toFixed(2).replace('.', ',')}`;
            document.getElementById('totalRatear').textContent = `R$ ${totalRatear.toFixed(2).replace('.', ',')}`;
            document.getElementById('valorPorParceiro').textContent = `R$ ${valorPorParceiro.toFixed(2).replace('.', ',')}`;
        }

        // Planilha de Parceiros
        function carregarPlanilhaParceiro() {
            const parceiroId = document.getElementById('selectParceiroPlanilha').value;
            const mes = document.getElementById('mesPlanilhaParceiro').value || new Date().toISOString().slice(0, 7);
            const container = document.getElementById('planilhaParceiroCont');
            
            if (!parceiroId) {
                container.innerHTML = '';
                return;
            }

            const parceiro = parceiros.find(p => p.id == parceiroId);
            const fluxoMes = fluxoCaixa.filter(f => f.mes === mes).sort((a, b) => new Date(a.data || 0) - new Date(b.data || 0));
            
            // Buscar saldo anterior do mês anterior
            let saldoAnterior = 0;
            const mesAnterior = new Date(mes + '-01');
            mesAnterior.setMonth(mesAnterior.getMonth() - 1);
            const mesAnteriorStr = mesAnterior.toISOString().slice(0, 7);
            const fluxoMesAnterior = fluxoCaixa.filter(f => f.mes === mesAnteriorStr);
            if (fluxoMesAnterior.length > 0) {
                let saldoFinalAnterior = 0;
                fluxoMesAnterior.forEach(f => {
                    saldoFinalAnterior += f.credito - f.debito - f.despesasEscritorio - f.retiradasLeila;
                });
