                                <th>Saldo Atual (R$)</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="planilhaParceiro_${parceiroId}">
            `;

            // Linha de saldo anterior
            html += `
                    <tr style="background-color: #f0f0f0; font-weight: bold;">
                        <td>-</td>
                        <td>SALDO ANTERIOR</td>
                        <td>-</td>
                        <td>-</td>
                        <td>R$ ${saldoAnterior.toFixed(2).replace('.', ',')}</td>
                        <td>-</td>
                    </tr>
            `;

            let saldoAtual = saldoAnterior;
            const clientesParceiro = clientes.filter(c => c.parceiro == parceiroId);
            const valorRateio = parseFloat(document.getElementById('valorPorParceiro').textContent.replace('R$ ', '').replace(',', '.')) || 0;

            // Processar lancamentos automaticos da Planilha de Parceiros (REGRA 1 e REGRA 2)
            const lancamentosParceiro = planilhaParceiros.filter(l => l.parceiroId == parceiroId);
            lancamentosParceiro.forEach(lancamento => {
                saldoAtual += lancamento.credito - lancamento.debito;
                html += `
                    <tr>
                        <td>${lancamento.data || '-'}</td>
                        <td>${lancamento.descricao}</td>
                        <td>${lancamento.debito > 0 ? lancamento.debito.toFixed(2).replace('.', ',') : '-'}</td>
