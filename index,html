        // Funcoes de Importacao de PDF (Escopo Global)
        function importarExtratoPDF() {
            const arquivo = document.getElementById('arquivoPDF').files[0];
            if (!arquivo) {
                alert('Selecione um arquivo PDF!');
                return;
            }
            alert('Importando PDF... Aguarde alguns segundos...');
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
            script.onload = function() {
                pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
                const fileReader = new FileReader();
                fileReader.onload = function(e) {
                    const typedarray = new Uint8Array(e.target.result);
                    pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                        let textoCompleto = '';
                        let paginasProcessadas = 0;
                        let numPaginas = pdf.numPages;
                        for (let i = 1; i <= numPaginas; i++) {
                            pdf.getPage(i).then(function(page) {
                                page.getTextContent().then(function(textContent) {
                                    const pageText = textContent.items.map(item => item.str).join(' ');
                                    textoCompleto += pageText + '\n';
                                    paginasProcessadas++;
                                    if (paginasProcessadas === numPaginas) {
                                        if (textoCompleto.trim().length < 50) {
                                            usarOCRParaPDF(pdf, numPaginas);
                                        } else {
                                            processarTextoPDFGlobal(textoCompleto);
                                        }
                                    }
                                });
                            });
                        }
                    }).catch(function(err) {
                        alert('Erro: ' + err.message);
                    });
                };
                fileReader.readAsArrayBuffer(arquivo);
            };
            script.onerror = function() {
                alert('Erro ao carregar PDF.js');
            };
            document.head.appendChild(script);
        }
        function processarTextoPDFGlobal(texto) {
            const mes = new Date().toISOString().slice(0, 7);
            const linhas = texto.split('\n');
            let movimentosAdicionados = 0;
            for (let i = 0; i < linhas.length; i++) {
                let linha = linhas[i].trim();
                if (linha.length < 15) continue;
                if (!/\d{2}\/\d{2}\/\d{4}/.test(linha)) continue;
                if (/SALDO DIA|SALDO ANTERIOR/.test(linha)) continue;
                const matchData = linha.match(/(\d{2}\/\d{2}\/\d{4})/);
                if (!matchData) continue;
                let tipo = '';
                if (/PIX RECEBIDO|DEVOLUCAO PIX|DEPOSITO/.test(linha)) {
                    tipo = 'CREDITO';
                } else if (/PIX ENVIADO|COMPRA|SAQUE|TRANSFERENCIA|ESTORNO COMPRA/.test(linha)) {
                    tipo = 'DEBITO';
                } else {
                    continue;
                }
                const matchValor = linha.match(/(\d+[.,]\d{2})\s*([DC])?/);
                if (!matchValor) continue;
                const valor = parseFloat(String(matchValor[1]).replace(',', '.'));
                const indicador = matchValor[2];
                const ehDebito = indicador === 'D' || tipo === 'DEBITO';
                const ehCredito = indicador === 'C' || tipo === 'CREDITO';
                if (valor > 0) {
                    let descricao = linha.substring(0, 100).trim();
                    if (/PIX ENVIADO/.test(linha)) descricao = 'PIX Enviado';
                    else if (/PIX RECEBIDO/.test(linha)) descricao = 'PIX Recebido';
                    else if (/COMPRA CARTAO/.test(linha)) descricao = 'Compra no Cartao';
                    else if (/ESTORNO|DEVOLUCAO/.test(linha)) descricao = 'Estorno/Devolucao';
                    else if (/TRANSFERENCIA/.test(linha)) descricao = 'Transferencia';
                    else if (/DEPOSITO/.test(linha)) descricao = 'Deposito';
                    else if (/SAQUE/.test(linha)) descricao = 'Saque';
                    if (typeof fluxoCaixa !== 'undefined') {
                        fluxoCaixa.push({
                            id: Date.now() + movimentosAdicionados,
                            mes,
                            saldoAnterior: 0,
                            descricao: descricao,
                            debito: ehDebito ? valor : 0,
                            credito: ehCredito ? valor : 0,
                            despesasEscritorio: 0,
                            retiradasLeila: 0
                        });
                        movimentosAdicionados++;
                    }
                }
            }
            if (movimentosAdicionados > 0) {
                if (typeof salvarDados === 'function') salvarDados();
                if (typeof atualizarFluxo === 'function') atualizarFluxo();
                if (typeof atualizarDashboard === 'function') atualizarDashboard();
                alert('Sucesso!\n\n' + movimentosAdicionados + ' movimentos foram importados.');
            } else {
                const textoExtraido = texto.substring(0, 200);
                const temTexto = textoExtraido.trim().length > 50;
                if (!temTexto) {
                    alert('Erro: O PDF nao contem texto extraivel.\n\nPossiveis causas:\n1. PDF eh uma imagem scaneada\n2. PDF esta protegido\n\nSolucao: Use um PDF com texto ou importe via CSV.');
                } else {
                    alert('Nenhum movimento encontrado no formato esperado.');
                }
            }
        }
        
        function usarOCRParaPDF(pdf, numPaginas) {
            alert('PDF eh uma imagem. Usando OCR para extrair texto... Aguarde...');
            const scriptTesseract = document.createElement('script');
            scriptTesseract.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js';
            scriptTesseract.onload = function() {
                let textoOCR = '';
                let paginasOCR = 0;
                for (let i = 1; i <= numPaginas; i++) {
                    pdf.getPage(i).then(function(page) {
                        const canvas = document.createElement('canvas');
                        const context = canvas.getContext('2d');
                        const viewport = page.getViewport({scale: 2});
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;
                        page.render({canvasContext: context, viewport: viewport}).promise.then(function() {
                            Tesseract.recognize(canvas, 'por').then(function(result) {
                                textoOCR += result.data.text + '\n';
                                paginasOCR++;
                                if (paginasOCR === numPaginas) {
                                    processarTextoPDFGlobal(textoOCR);
                                }
                            }).catch(function(err) {
                                alert('Erro no OCR: ' + err.message);
                            });
                        });
                    });
                }
            };
            scriptTesseract.onerror = function() {
                alert('Erro ao carregar Tesseract.js');
            };
            document.head.appendChild(scriptTesseract);
        }
