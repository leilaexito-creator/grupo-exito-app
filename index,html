                    <td></td>
                </tr>
            `;
            
            let saldoAtual = saldoAnterior;
            
            previsoesMes.forEach(prev => {
                const hoje = new Date();
                const dataVencimento = new Date(prev.data);
                const diasAtraso = Math.floor((hoje - dataVencimento) / (1000 * 60 * 60 * 24));
                
                let status = 'Pendente';
                if (prev.pago) {
                    status = 'Pago';
