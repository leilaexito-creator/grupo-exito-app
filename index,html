        function gerarRespostaIA(pergunta) {
            pergunta = pergunta.toLowerCase();
            
            if (pergunta.includes('gasto') || pergunta.includes('despesa') || pergunta.includes('maior')) {
                const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
                const fluxoMes = fluxoCaixa.filter(f => f.mes === mes);
                let totalDespesas = 0;
                fluxoMes.forEach(f => totalDespesas += f.debito + f.despesasEscritorio);
                return `Seus gastos totais no mês são de R$ ${totalDespesas.toFixed(2).replace('.', ',')}. Recomendo revisar as despesas de escritório para possíveis reduções.`;
            }

            if (pergunta.includes('receita') || pergunta.includes('recebimento') || pergunta.includes('faturamento')) {
                const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
                const fluxoMes = fluxoCaixa.filter(f => f.mes === mes);
                let totalReceitas = 0;
                fluxoMes.forEach(f => totalReceitas += f.credito);
                return `Suas receitas totais no mês são de R$ ${totalReceitas.toFixed(2).replace('.', ',')}. Você tem ${previsoes.filter(p => !p.pago).length} recebimentos pendentes.`;
            }

            if (pergunta.includes('saldo') || pergunta.includes('caixa')) {
                const mes = document.getElementById('mesReferencia').value || new Date().toISOString().slice(0, 7);
                const fluxoMes = fluxoCaixa.filter(f => f.mes === mes);
                let saldo = 0;
                fluxoMes.forEach(f => saldo += f.credito - f.debito - f.despesasEscritorio - f.retiradasLeila);
                return `Seu saldo atual é de R$ ${saldo.toFixed(2).replace('.', ',')}. ${saldo > 0 ? 'Situação positiva!' : 'Atenção: saldo negativo!'}`;
            }

            if (pergunta.includes('inadimpl') || pergunta.includes('atraso') || pergunta.includes('cliente')) {
                const inadimplentes = previsoes.filter(p => !p.pago);
                if (inadimplentes.length === 0) {
                    return 'Ótima notícia! Nenhum cliente em atraso.';
                }
                return `Você tem ${inadimplentes.length} cliente(s) em atraso. Recomendo entrar em contato para cobrar os pagamentos.`;
            }

            if (pergunta.includes('parceiro')) {
                const totalParceiros = parceiros.length;
                const totalClientesParceiros = clientes.filter(c => c.parceiro).length;
                return `Você tem ${totalParceiros} parceiro(s) cadastrado(s), atendendo ${totalClientesParceiros} cliente(s). Distribua melhor os clientes entre os parceiros.`;
            }

            const respostas = [
                'Analisando seus dados financeiros...',
                'Com base nos dados, você tem ' + clientes.length + ' clientes cadastrados.',
                'Recomendo revisar as despesas de funcionários.',
                'Seus parceiros estão gerando bom retorno.',
                'Mantenha o fluxo de caixa sempre atualizado para melhor controle.'
            ];
            return respostas[Math.floor(Math.random() * respostas.length)];
        }

        // Importar Extratos
        function importarExtratoCSV() {
            const arquivo = document.getElementById('arquivoCSV').files[0];
            if (!arquivo) {
                alert('Selecione um arquivo CSV!');
                return;
            }

            Papa.parse(arquivo, {
                header: true,
                dynamicTyping: false,
                skipEmptyLines: true,
                complete: function(results) {
                    if (results.errors.length > 0) {
                        alert('Erros ao processar CSV:\n' + results.errors.map(e => e.message).join('\n'));
                        return;
                    }

                    let movimentosAdicionados = 0;
                    const dataAtual = new Date();

                    results.data.forEach((row, index) => {
                        try {
                            const dataStr = String(row.Data || row.data || row.DATE || '').trim();
                            const descricao = String(row.Descrição || row.descricao || row.Descricao || row.DESCRICAO || row.Description || '').trim();
                            const tipo = String(row.Tipo || row.tipo || row.TYPE || '').trim().toLowerCase();
                            const valorStr = String(row.Valor || row.valor || row.VALUE || '').trim();

                            if (!dataStr || !descricao || !tipo || !valorStr) return;

                            let dataFormatada = dataStr;
                            if (/^\d{2}\/\d{2}\/\d{4}$/.test(dataStr)) {
                                const [dia, mes, ano] = dataStr.split('/');
                                dataFormatada = ano + '-' + mes + '-' + dia;
                            } else if (!/^\d{4}-\d{2}-\d{2}$/.test(dataStr)) {
                                return;
                            }

                            const valor = parseFloat(String(valorStr).replace('.', '').replace(',', '.'));
                            if (isNaN(valor) || valor <= 0) return;

                            const ehCredito = tipo === 'credito' || tipo === 'entrada' || tipo === 'recebimento' || tipo === 'credit' || tipo === 'income';
                            const ehDebito = tipo === 'debito' || tipo === 'saida' || tipo === 'pagamento' || tipo === 'debit' || tipo === 'expense';

