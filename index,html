        function atualizarTabelaPrevisaoPagamentos() {
            const mesAtual = new Date().toISOString().slice(0, 7);
            const pagamentos = previsaoPagamentos[mesAtual] || [];
            const tabela = document.getElementById('previsaoPagamentosTable');
            tabela.innerHTML = '';

            const hoje = new Date();
            let total = 0;
            
            pagamentos.forEach((pag, index) => {
                const dataVencimento = new Date(pag.vencimento);
                dataVencimento.setHours(0, 0, 0, 0);
                
                const diasAtraso = Math.floor((hoje - dataVencimento) / (1000 * 60 * 60 * 24));
                const status = pag.pago ? '✅ Pago' : (diasAtraso > 0 ? '🚨 Em atraso' : '⏳ Pendente');
                
                if (!pag.pago) {
                    const row = tabela.insertRow();
                    row.style.backgroundColor = diasAtraso > 0 ? '#ffeeba' : '';
                    row.innerHTML = `
                        <td>${pag.nome}</td>
                        <td>R$ ${pag.valor.toFixed(2).replace('.', ',')}</td>
                        <td>${formatarData(dataVencimento)}</td>
                        <td>${diasAtraso > 0 ? diasAtraso : '-'}</td>
                        <td><span style="color: ${diasAtraso > 0 ? '#ff6b6b' : '#666'};">${status}</span></td>
                        <td><button class="btn btn-danger" onclick="removerPagamentoPrevisao(${index})">Remover</button></td>
                    `;
                    total += pag.valor;
                }
            });

            document.getElementById('totalPrevisaoPagamentos').textContent = `R$ ${total.toFixed(2).replace('.', ',').replace('.', ',')}`;
        }

        function removerPagamentoPrevisao(index) {
            const mesAtual = new Date().toISOString().slice(0, 7);
            if (previsaoPagamentos[mesAtual]) {
                previsaoPagamentos[mesAtual].splice(index, 1);
                salvarDados();
                atualizarTabelaPrevisaoPagamentos();
            }
        }

        function sincronizarPagamentoPrevisao() {
            const mesAtual = new Date().toISOString().slice(0, 7);
            const pagamentos = previsaoPagamentos[mesAtual] || [];
            const fluxoAtual = fluxoCaixa[mesAtual] || [];

            fluxoAtual.forEach(mov => {
                if (mov.tipo === 'debito' && mov.descricao) {
                    pagamentos.forEach(pag => {
                        if (mov.descricao.toLowerCase().includes(pag.nome.toLowerCase()) && !pag.pago) {
                            pag.pago = true;
                            pag.dataPagamento = new Date().toISOString().slice(0, 10);
                        }
                    });
                }
            });

            salvarDados();
            atualizarTabelaPrevisaoPagamentos();
        }

        // Previsão de Recebimentos
        function atualizarTabelaPrevisaoRecebimentos() {
            const mes = document.getElementById('mesPrevisaoRecebimentos').value || new Date().toISOString().slice(0, 7);
            const [anoSelecionado, mesSelecionado] = mes.split('-').map(Number);
            
            // Inicializar previsaoRecebimentos[mes] se não existir
            if (!previsaoRecebimentos[mes]) {
                previsaoRecebimentos[mes] = [];
            }
            
            // Limpar previsões do mês
            previsaoRecebimentos[mes] = [];
            
            clientes.forEach(cliente => {
                // Se o cliente tem dia de vencimento definido
                // E NÃO é 100% Retirada Parceiros
                if (cliente.diaVencimento && cliente.retiradadaParceiros !== 'sim') {
                    const diaVenc = cliente.diaVencimento;
                    
                    // Criar data de vencimento para o mês selecionado
                    let vencimento = new Date(anoSelecionado, mesSelecionado - 1, diaVenc);
                    
                    // Se o dia não existe no mês (ex: 31 de fevereiro), usar o último dia do mês
                    if (vencimento.getMonth() !== mesSelecionado - 1) {
                        vencimento = new Date(anoSelecionado, mesSelecionado, 0);
                    }
                    
                    // Verificar se já foi recebido no Fluxo de Caixa para este mês
                    const fluxoMes = fluxoCaixa.filter(f => f.mes === mes);
                    
                    const jaRecebido = fluxoMes.some(f =>
                        f.descricao.toLowerCase().includes(cliente.razaoSocial.toLowerCase()) &&
                        f.credito > 0
                    );
                    
                    if (!jaRecebido) {
                        const hoje = new Date();
                        const diasAtraso = Math.floor((hoje - vencimento) / (1000 * 60 * 60 * 24));
                        const status = diasAtraso > 0 ? `🚨 ${diasAtraso} dias em atraso` : '✅ No prazo';
                        const statusClass = diasAtraso > 0 ? 'color: #ff6b6b;' : 'color: #51cf66;';
                        
                        previsaoRecebimentos[mes].push({
                            cliente: cliente.razaoSocial,
                            valor: cliente.valorContrato,
                            vencimento: formatarData(vencimento),
                            diasAtraso: diasAtraso,
                            status: status,
                            statusClass: statusClass
                        });
                    }
                }
            });
            
            const tbody = document.getElementById('previsaoRecebimentosTable');
            tbody.innerHTML = '';
            
            let total = 0;
            previsaoRecebimentos[mes].forEach(rec => {
                tbody.innerHTML += `
                    <tr>
                        <td>${rec.cliente}</td>
                        <td>R$ ${rec.valor.toFixed(2).replace('.', ',')}</td>
                        <td>${rec.vencimento}</td>
                        <td>${rec.diasAtraso}</td>
                        <td><span style="${rec.statusClass}">${rec.status}</span></td>
                        <td>
                            <button class="btn btn-success btn-small" onclick="marcarComoRecebido('${rec.cliente}', ${rec.valor})">Recebido</button>
                        </td>
                    </tr>
                `;
                total += rec.valor;
            });
            
            document.getElementById('totalPrevisaoRecebimentos').textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
            salvarDados();
        }

        function marcarComoRecebido(nomeCliente, valor) {
            const mes = document.getElementById('mesPrevisaoRecebimentos').value || new Date().toISOString().slice(0, 7);
            const data = formatarData(new Date());
            
