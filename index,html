        function atualizarResumoDespesas(mes) {
            // Puxar retiradas do Fluxo de Caixa
            const retiradas = fluxoCaixa
                .filter(f => f.mes === mes && f.retiradasLeila && f.retiradasLeila > 0)
                .map(f => ({
                    id: f.id,
                    data: f.data || formatarData(new Date()),
                    categoria: 'Retirada Dra. Leila',
                    descricao: f.descricao,
                    valor: f.retiradasLeila,
                    mes: f.mes
                }));
            
            // Combinar com despesas manuais
            const despesasMes = [...retiradas, ...despesasLeila.filter(d => d.mes === mes)];
            
            // Agrupar por categoria
            const categorias = {};
            despesasMes.forEach(despesa => {
                if (!categorias[despesa.categoria]) {
                    categorias[despesa.categoria] = 0;
                }
                categorias[despesa.categoria] += despesa.valor;
            });
            
            // Calcular total
            let totalDespesas = 0;
            Object.values(categorias).forEach(valor => {
                totalDespesas += valor;
            });

            // Atualizar tabela de resumo
            const tbodyResumo = document.getElementById('resumoDespesasTable');
            tbodyResumo.innerHTML = '';
            
            Object.entries(categorias).sort((a, b) => b[1] - a[1]).forEach(([categoria, valor]) => {
                const percentual = totalDespesas > 0 ? ((valor / totalDespesas) * 100).toFixed(1) : 0;
                tbodyResumo.innerHTML += `
                    <tr>
                        <td><strong>${categoria}</strong></td>
                        <td>R$ ${valor.toFixed(2).replace('.', ',')}</td>
                        <td>${percentual}%</td>
                    </tr>
                `;
            });

            // Atualizar total
            document.getElementById('totalDespesasLeila').textContent = `R$ ${totalDespesas.toFixed(2).replace('.', ',')}`;
        }

