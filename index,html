        // CLIENTES INADIMPLENTES (BASEADO EM CADASTRO DE CLIENTES)
        function atualizarTabelaClientesInadimplentes() {
            const tbody = document.getElementById('inadimplentesTable');
            if (!tbody) return;

            tbody.innerHTML = '';
            const hoje = new Date();

            clientes.forEach(cliente => {
                if (!cliente.diaVencimento) return;

                // 📌 CALCULAR VENCIMENTO PARA CADA MÊS ATÉ ENCONTRAR UM EM ATRASO
                let vencimento = null;
                let encontrouAtraso = false;

                // Verificar os últimos 12 meses
                for (let i = 0; i < 12; i++) {
                    const dataTemp = new Date(hoje);
                    dataTemp.setMonth(dataTemp.getMonth() - i);
                    
                    const ano = dataTemp.getFullYear();
                    const mes = dataTemp.getMonth();
                    
                    let vencTemp = new Date(ano, mes, cliente.diaVencimento);
                    
                    // Ajustar último dia do mês
                    if (vencTemp.getMonth() !== mes) {
                        vencTemp = new Date(ano, mes + 1, 0);
                    }
                    
                    // Se este vencimento está no passado (em atraso)
                    if (hoje > vencTemp) {
                        vencimento = vencTemp;
                        encontrouAtraso = true;
                        break;
                    }
                }

                // Se não encontrou atraso, pula
                if (!encontrouAtraso || !vencimento) return;

                // 📌 VERIFICAR SE FOI RECEBIDO NO FLUXO DE CAIXA (APÓS O VENCIMENTO)
                const jaRecebido = fluxoCaixa.some(f => {
                    const dataFluxo = new Date(f.data.split('/').reverse().join('-'));
                    return f.credito > 0 && 
                           dataFluxo > vencimento &&
                           f.descricao.toLowerCase().includes(cliente.razaoSocial.toLowerCase());
                });

                // Se pagou, não é inadimplente
                if (jaRecebido) return;

                // 📌 DIAS DE ATRASO
                const diasAtraso = Math.floor((hoje - vencimento) / (1000 * 60 * 60 * 24));

                tbody.innerHTML += `
                    <tr style="background-color:#fff3cd;">
                        <td>${cliente.razaoSocial}</td>
                        <td>R$ ${cliente.valorContrato.toFixed(2).replace('.', ',')}</td>
                        <td>${formatarData(vencimento)}</td>
                        <td>${diasAtraso}</td>
                        <td><span style="color:#ff6b6b;">🚨 ${diasAtraso} dias em atraso</span></td>
                    </tr>
                `;
            });
        }

        
