                        <td>-</td>
                        <td>R$ ${saldoAtual.toFixed(2).replace('.', ',')}</td>
                        <td>-</td>
                    </tr>
                `;
            }

            // Adicionar rateio de despesas do escritório
            if (valorRateio > 0) {
                saldoAtual -= valorRateio;
                html += `
                    <tr>
                        <td>-</td>
                        <td><input type="text" value="Rateio - Despesas do Escritório" onchange="atualizarMovimentoParceiro(${parceiroId}, this, 'descricao')"></td>
