                    </div>
                </div>
            </div>
        </main>

        <div class="navigation-buttons">
            <button class="nav-button" id="btnVoltar" onclick="voltarAba()">⬅️ VOLTAR</button>
            <div class="page-indicator" id="pageIndicator">Página 1 de 10</div>
            <button class="nav-button" id="btnAvancar" onclick="avancarAba()">AVANÇAR ➡️</button>
        </div>
