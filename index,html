        }

        function atualizarRelatorioRecebimentos() {
            const mes = document.getElementById('mesRelatorioRecebimentos').value || new Date().toISOString().slice(0, 7);
            const parceiroId = document.getElementById('parceiroRelatorioRecebimentos').value;
            const [anoSelecionado, mesSelecionado] = mes.split('-').map(Number);
            
            if (!parceiroId) {
                document.getElementById('relatorioRecebimentosTable').innerHTML = '';
                return;
            }
            
            // Filtrar clientes
            let clientesParceiro = [];
            let parceiroNome = '';
            
            if (parceiroId === 'TODOS') {
                // Mostrar todos os clientes
                clientesParceiro = clientes;
                parceiroNome = 'TODOS';
            } else {
                // Encontrar o parceiro selecionado
                const parceiro = parceiros.find(p => p.id == parceiroId);
                parceiroNome = parceiro.nome;
                // Filtrar clientes deste parceiro (comparar pelo ID do parceiro)
                clientesParceiro = clientes.filter(c => c.parceiro == parceiroId || c.parceiroResponsavel === parceiro.nome);
            }
            
            // Agrupar por dia de vencimento
            const recebimentosPorDia = {};
            
            clientesParceiro.forEach(cliente => {
                if (cliente.diaVencimento) {
                    const dia = cliente.diaVencimento;
                    if (!recebimentosPorDia[dia]) {
                        recebimentosPorDia[dia] = [];
                    }
                    
                    // Calcular décimo terceiro
                    let decimo13Total = 0;
                    let parcela1 = 0;
                    let parcela2 = 0;
                    
                    if ((mesSelecionado === 11 || mesSelecionado === 12)) { // Novembro ou Dezembro
                        const dataStr = cliente.dataFechamento || cliente.dataFechamentoContrato;
                        const dataFechamento = new Date(dataStr);
                        const anoContrato = dataFechamento.getFullYear();
                        const mesContrato = dataFechamento.getMonth() + 1;
                        
                        if (anoContrato < anoSelecionado) {
                            // Contrato anterior ao ano atual: 13º integral
                            decimo13Total = cliente.valorContrato;
                        } else if (anoContrato === anoSelecionado) {
                            // Contrato no mesmo ano: proporcional
                            const mesesRestantes = 12 - mesContrato + 1;
                            decimo13Total = (cliente.valorContrato * mesesRestantes) / 12;
                        }
                        
                        // Dividir em 2 parcelas
                        parcela1 = decimo13Total / 2;
                        parcela2 = decimo13Total / 2;
                    }
                    
                    recebimentosPorDia[dia].push({
                        cliente: cliente.razaoSocial,
                        valor: cliente.valorContrato,
                        dataFechamento: cliente.dataFechamento || cliente.dataFechamentoContrato || '-',
                        decimo13Total: decimo13Total,
                        parcela1: parcela1,
                        parcela2: parcela2,
                        parceiro: cliente.parceiroResponsavel || 'N/A'
                    });
                }
            });
            
            // Ordenar dias
            const diasOrdenados = Object.keys(recebimentosPorDia).map(Number).sort((a, b) => a - b);
            
            const tbody = document.getElementById('relatorioRecebimentosTable');
            tbody.innerHTML = '';
            
            let totalDia = 0;
            let diaAnterior = null;
            let totalMensal = 0;
            let totalDecimo13Mensal = 0;
            let totalParcela1Mensal = 0;
            let totalParcela2Mensal = 0;
            
            diasOrdenados.forEach(dia => {
                recebimentosPorDia[dia].forEach((rec, index) => {
                    const dataVencimento = new Date(anoSelecionado, mesSelecionado - 1, dia);
                    const dataVencStr = formatarData(dataVencimento);
                    
                    if (index === 0 && dia !== diaAnterior) {
                        totalDia = 0;
                        diaAnterior = dia;
                    }
                    
                    totalDia += rec.valor;
                    totalMensal += rec.valor;
                    totalDecimo13Mensal += rec.decimo13Total;
                    totalParcela1Mensal += rec.parcela1;
                    totalParcela2Mensal += rec.parcela2;
                    
                    tbody.innerHTML += `
                        <tr>
                            <td>${dataVencStr}</td>
                            <td>${rec.cliente}</td>
                            <td>${parceiroId === 'TODOS' ? rec.parceiro : parceiroNome}</td>
                            <td>R$ ${rec.valor.toFixed(2).replace('.', ',')}</td>
                            <td>${formatarData(dataVencimento)}</td>
                            <td>${formatarData(rec.dataFechamento)}</td>
                            <td>R$ ${rec.decimo13Total.toFixed(2).replace('.', ',')}</td>
                            <td>R$ ${rec.parcela1.toFixed(2).replace('.', ',')}</td>
                            <td>R$ ${rec.parcela2.toFixed(2).replace('.', ',')}</td>
                        </tr>
                    `;
                    
                    // Adicionar linha de total do dia
                    if (index === recebimentosPorDia[dia].length - 1) {
                        const totalDecimo = recebimentosPorDia[dia].reduce((sum, r) => sum + r.decimo13Total, 0);
                        const totalParcela1 = recebimentosPorDia[dia].reduce((sum, r) => sum + r.parcela1, 0);
                        const totalParcela2 = recebimentosPorDia[dia].reduce((sum, r) => sum + r.parcela2, 0);
                        
                        tbody.innerHTML += `
                            <tr style="background-color: #f0f0f0; font-weight: bold;">
                                <td colspan="3">TOTAL DO DIA ${dia.toString().padStart(2, '0')}</td>
                                <td>R$ ${totalDia.toFixed(2).replace('.', ',')}</td>
                                <td>-</td>
                                <td>-</td>
                                <td>R$ ${totalDecimo.toFixed(2).replace('.', ',')}</td>
                                <td>R$ ${totalParcela1.toFixed(2).replace('.', ',')}</td>
                                <td>R$ ${totalParcela2.toFixed(2).replace('.', ',')}</td>
                            </tr>
                        `;
                    }
                });
            });
            
            // Adicionar linha de total mensal
            tbody.innerHTML += `
                <tr style="background-color: #4472C4; color: white; font-weight: bold; font-size: 1.1em;">
                    <td colspan="3">TOTAL DO MES</td>
                    <td>R$ ${totalMensal.toFixed(2).replace('.', ',')}</td>
                    <td>-</td>
                    <td>-</td>
                    <td>R$ ${totalDecimo13Mensal.toFixed(2).replace('.', ',')}</td>
                    <td>R$ ${totalParcela1Mensal.toFixed(2).replace('.', ',')}</td>
                    <td>R$ ${totalParcela2Mensal.toFixed(2).replace('.', ',')}</td>
                </tr>
            `;
        }

